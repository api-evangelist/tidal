{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIDAL Catalog acceptedTerms trackStatistics API",
    "version": "1.10.14"
  },
  "items": [
    {
      "info": {
        "name": "trackStatistics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get multiple trackStatistics.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/trackStatistics",
            "params": [
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "filter[id]",
                "value": "",
                "type": "query",
                "description": "List of track IDs (e.g. `75413016`)"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves multiple trackStatistics by available filters, or without if applicable."
        },
        {
          "info": {
            "name": "Get single trackStatistic.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/trackStatistics/:id",
            "params": [
              {
                "name": "id",
                "value": "123456",
                "type": "path",
                "description": "Track statistic id"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves single trackStatistic by id."
        },
        {
          "info": {
            "name": "Get owners relationship (\"to-many\").",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/trackStatistics/:id/relationships/owners",
            "params": [
              {
                "name": "id",
                "value": "123456",
                "type": "path",
                "description": "Track statistic id"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves owners relationship."
        }
      ]
    }
  ],
  "bundled": true
}