      },
      "items": [
        {
          "info": {
            "name": "Get multiple trackSourceFiles.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/trackSourceFiles",
            "params": [
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "filter[id]",
                "value": "",
                "type": "query",
                "description": "Track source file id (e.g. `a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11`)"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves multiple trackSourceFiles by available filters, or without if applicable."
        },
        {
          "info": {
            "name": "Create single trackSourceFile.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://openapi.tidal.com/v2/trackSourceFiles",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a track source file. <p/>\nThe response contains a upload link that must be used to upload the actual content.<p/>\nThe headers in the upload link response must be sent doing the actual upload.\n"
        },
        {
          "info": {
            "name": "Get single trackSourceFile.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/trackSourceFiles/:id",
            "params": [
              {
                "name": "id",
                "value": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11",
                "type": "path",
                "description": "Track source file id"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves single trackSourceFile by id."
        },
        {
