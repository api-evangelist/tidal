  "items": [
    {
      "info": {
        "name": "installations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get multiple installations.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/installations",
            "params": [
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              },
              {
                "name": "include",
                "value": "offlineInventory",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: offlineInventory, owners"
              },
              {
                "name": "filter[clientProvidedInstallationId]",
                "value": "",
                "type": "query",
                "description": "Client-provided installation identifier to filter by (e.g. `a468bee88def`)"
              },
              {
                "name": "filter[id]",
                "value": "",
                "type": "query",
                "description": "List of installation IDs (e.g. `a468bee88def`)"
              },
              {
                "name": "filter[owners.id]",
                "value": "",
                "type": "query",
                "description": "User ID to filter by. Use `me` for the authenticated user"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves multiple installations by available filters, or without if applicable."
        },
