{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIDAL Catalog acceptedTerms shares API",
    "version": "1.10.14"
  },
  "items": [
    {
      "info": {
        "name": "shares",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get multiple shares.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/shares",
            "params": [
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners, sharedResources"
              },
              {
                "name": "filter[code]",
                "value": "",
                "type": "query",
                "description": "A share code (e.g. `xyz`)"
              },
              {
                "name": "filter[id]",
                "value": "",
                "type": "query",
                "description": "List of shares IDs (e.g. `a468bee88def`)"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves multiple shares by available filters, or without if applicable."
        },
        {
          "info": {
            "name": "Create single share.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://openapi.tidal.com/v2/shares",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new share."
        },
        {
          "info": {
            "name": "Get single share.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/shares/:id",
            "params": [
              {
                "name": "id",
                "value": "a468bee88def",
                "type": "path",
                "description": "User share id"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners, sharedResources"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves single share by id."
        },
        {
          "info": {
            "name": "Get owners relationship (\"to-many\").",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/shares/:id/relationships/owners",
            "params": [
              {
                "name": "id",
                "value": "a468bee88def",
                "type": "path",
                "description": "User share id"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves owners relationship."
        },
        {
          "info": {
            "name": "Get sharedResources relationship (\"to-many\").",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/shares/:id/relationships/sharedResources",
            "params": [
              {
                "name": "id",
                "value": "a468bee88def",
                "type": "path",
                "description": "User share id"
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              },
              {
                "name": "include",
                "value": "sharedResources",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: sharedResources"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves sharedResources relationship."
        }
      ]
    }
  ],
  "bundled": true
}