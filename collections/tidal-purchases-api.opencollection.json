{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIDAL Catalog acceptedTerms purchases API",
    "version": "1.10.14"
  },
  "items": [
    {
      "info": {
        "name": "purchases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get multiple purchases.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/purchases",
            "params": [
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners, subject"
              },
              {
                "name": "filter[owners.id]",
                "value": "",
                "type": "query",
                "description": "User id. Use `me` for the authenticated user"
              },
              {
                "name": "filter[subject.type]",
                "value": "",
                "type": "query",
                "description": "The type of purchased content (e.g. `albums`)"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves multiple purchases by available filters, or without if applicable."
        },
        {
          "info": {
            "name": "Get owners relationship (\"to-many\").",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/purchases/:id/relationships/owners",
            "params": [
              {
                "name": "id",
                "value": "3fG7kLmN2pQrStUv",
                "type": "path",
                "description": "Purchase id"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves owners relationship."
        },
        {
          "info": {
            "name": "Get subject relationship (\"to-one\").",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/purchases/:id/relationships/subject",
            "params": [
              {
                "name": "id",
                "value": "3fG7kLmN2pQrStUv",
                "type": "path",
                "description": "Purchase id"
              },
              {
                "name": "include",
                "value": "subject",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: subject"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves subject relationship."
        }
      ]
    }
  ],
  "bundled": true
}