{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIDAL Catalog acceptedTerms stripeConnections API",
    "version": "1.10.14"
  },
  "items": [
    {
      "info": {
        "name": "stripeConnections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get multiple stripeConnections.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/stripeConnections",
            "params": [
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "filter[owners.id]",
                "value": "",
                "type": "query",
                "description": "User id. Use `me` for the authenticated user"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves multiple stripeConnections by available filters, or without if applicable."
        },
        {
          "info": {
            "name": "Create single stripeConnection.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://openapi.tidal.com/v2/stripeConnections",
            "params": [
              {
                "name": "countryCode",
                "value": "US",
                "type": "query",
                "description": "ISO 3166-1 alpha-2 country code"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new stripeConnection."
        },
        {
          "info": {
            "name": "Get owners relationship (\"to-many\").",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.tidal.com/v2/stripeConnections/:id/relationships/owners",
            "params": [
              {
                "name": "id",
                "value": "me",
                "type": "path",
                "description": "Stripe connection id. Use `me` for the authenticated user's resource"
              },
              {
                "name": "include",
                "value": "owners",
                "type": "query",
                "description": "Allows the client to customize which related resources should be returned. Available options: owners"
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "Server-generated cursor value pointing a certain page of items. Optional, targets first page if not specified"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.tidal.com/authorize",
              "accessTokenUrl": "https://auth.tidal.com/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves owners relationship."
        }
      ]
    }
  ],
  "bundled": true
}